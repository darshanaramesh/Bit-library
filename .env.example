# ---------------------------------------------------------------------------
# BIT Central Library - environment configuration template
# ---------------------------------------------------------------------------
# Copy this file to `.env` (git-ignored) and fill in real values.
# Never commit real credentials.

# --- General -----------------------------------------------------------------
NODE_ENV=development
PORT=5000

# --- MySQL database ----------------------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_NAME=bit_central_library
DB_USER=root
DB_PASSWORD=

# --- Authentication (JWT) ----------------------------------------------------
JWT_SECRET=
JWT_EXPIRES_IN=1d

# --- AI chatbot --------------------------------------------------------------
AI_API_KEY=
AI_MODEL=

# --- Frontend (Vite) ---------------------------------------------------------
# Vite variables are exposed to the browser and must be prefixed with VITE_.
VITE_API_BASE_URL=http://localhost:5000/api
